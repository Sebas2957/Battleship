<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10" style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.Battleship.Controllers.GameController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15"/>
    </padding>

    <HBox alignment="CENTER" spacing="30">
        <Label fx:id="nameLabel" text="Jugador" textFill="#00d4ff">
            <font>
                <Font name="System Bold" size="18"/>
            </font>
        </Label>
        <Label fx:id="labelTurnInGame" text="TURNO DE: Jugador" textFill="#e94560">
            <font>
                <Font name="System Bold" size="20"/>
            </font>
        </Label>
        <Button onAction="#OnActionNewGame" prefHeight="35"
                style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                text="🔄 Nuevo Juego"/>
    </HBox>

    <Label fx:id="informationLabel" text="¡Haz clic en el tablero enemigo para disparar!" textFill="#888888">
        <font>
            <Font size="12"/>
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="40">

        <VBox alignment="CENTER" spacing="5">
            <Label text="TU FLOTA" textFill="#00d4ff">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
            <HBox alignment="CENTER">
                <AnchorPane fx:id="rowsPane" prefHeight="400" prefWidth="30"/>
                <VBox>
                    <AnchorPane fx:id="columnsPane" prefHeight="30" prefWidth="400"/>
                    <AnchorPane fx:id="panePosition" prefHeight="400" prefWidth="400"
                                style="-fx-background-color: #0a1628; -fx-border-color: #00d4ff; -fx-border-width: 2;"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox alignment="CENTER" spacing="5">
            <Label text="FLOTA ENEMIGA" textFill="#e94560">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
            <HBox alignment="CENTER">
                <AnchorPane fx:id="rowsPaneMachine" prefHeight="400" prefWidth="30"/>
                <VBox>
                    <AnchorPane fx:id="columnsPaneMachine" prefHeight="30" prefWidth="400"/>
                    <AnchorPane fx:id="panePositionMachine" prefHeight="400" prefWidth="400"
                                style="-fx-background-color: #0a1628; -fx-border-color: #e94560; -fx-border-width: 2; -fx-cursor: crosshair;"/>
                </VBox>
            </HBox>
        </VBox>
    </HBox>
</VBox>